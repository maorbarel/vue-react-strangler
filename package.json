{
  "name": "vue-react-strangler",
  "private": true,
  "type": "module",
  "description": "Incrementally migrate a Vue 3 app to React with the strangler-fig pattern and webpack Module Federation.",
  "author": "Maor Barel",
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter legacy-vue build && pnpm --filter shell-react build && node scripts/assemble.mjs",
    "preview": "pnpm --filter shell-react preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "@playwright/test": "1.58.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
